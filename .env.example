# SheShield — Environment Variables Template for Vercel Deployment
# In Vercel: Project Settings -> Environment Variables

# ==============================================================================
# 1. Supabase Configuration (Required)
# Retrieve from: Supabase Dashboard -> Project Settings -> API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# ==============================================================================
# 2. Google Maps Platform (Recommended for Google Maps Canvas)
# Client-side Maps JavaScript API key
# ==============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-api-key

# ==============================================================================
# 3. Google Gemini AI (Recommended for Safety Assistant)
# Server-side API key for gemini-3.8-flash (has deterministic fallback if omitted)
# ==============================================================================
GEMINI_API_KEY=AIzaSy...your-gemini-api-key

# ==============================================================================
# 4. Optional Configurations (Defaults work out-of-the-box)
# ==============================================================================
# Vector Tile Style URL (defaults to Carto Positron):
# NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# SMS Provider for SOS Dispatch (defaults to safe test-mode simulation):
# SMS_PROVIDER=test
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=SHESHLD

# Routing Engine (defaults to free OSRM demo server):
# ROUTING_PROVIDER=osrm
# ROUTING_API_KEY=

